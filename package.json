{
  "name": "@fabplane/fab-router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "independent PCB autorouter for the FabPlane toolchain: SPECCTRA DSN in, SES out.",
  "exports": {
    ".": "./src/api.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 120000",
