+++ b/src/route/visibility-recovery.ts
@@ -17,0 +18,20 @@ import type {RecoveryTrial} from './recovery-schedule.ts';
+/** Negative shaping cache for one synchronous target/profile on unchanged copper.
+ * Successful paths are never retained, so callers cannot alias cached vertices.
+ * The coordinator owns this cache; discard it between targets and clear it BEFORE
+ * any journal insertion, including a proposal that will subsequently roll back.
+ */
+export function createVisibilityShaper(layout:Layout,lattice:Lattice,profile:Profile){
+ const blocked=new Set<string>(),ignore=ignoreOf(profile.net);
+ return {
+  clear(){blocked.clear();},
+  legalise(sheet:number,from:Pt,to:Pt):ReturnType<typeof legaliseTrail>{
+   const key=`${sheet}:${from.x},${from.y}:${to.x},${to.y}`;
+   if(blocked.has(key))return {ok:false,pts:[],widths:[]};
+   const leg=legaliseTrail(layout,lattice,sheet,[from,to],profile,ignore,false);
+   // Retain a hard memory bound even if a future caller supplies a larger budget.
+   if(!leg.ok&&blocked.size<100000)blocked.add(key);
+   return leg;
+  },
+ };
+}
+
