+test('negative shaping reuse preserves region growth, budget boundaries and journal rewind',()=>{
+ for(const maxExpansions of [1,10,1000])for(const cap of [2,512]){
+  const runs=[];
+  for(const cached of [false,true]){
+   const {l,lattice,journal,profile}=fixture(),before=writeSes(l),mark=journal.mark();
+   const shaper=cached?createVisibilityShaper(l,lattice,profile):undefined,outcomes:ReturnType<typeof proposeVisibility>[]=[];
+   const result=scheduleRecovery(l,lattice,journal,target,{...plan,maxExpansions},t=>{
+    outcomes.push(proposeVisibility(l,lattice,journal,target,profile,t,cap,true,shaper));
+   });
+   runs.push({result,outcomes,ses:writeSes(l),exact:checkDrc(l).counts.violations,remaining:requiredConnections(l)});
+   journal.rewind(mark);expect(writeSes(l)).toBe(before);
+  }
+  expect(runs[1]).toEqual(runs[0]);
+ }
+});
+test('negative shaping cache clears across copper removal and does not retain successful vertices',()=>{
+ const {l,lattice,journal,profile}=fixture(),shaper=createVisibilityShaper(l,lattice,profile);
+ const from={x:0,y:10000},to={x:10000,y:10000},mark=journal.mark();
+ const first=shaper.legalise(0,from,to);expect(first.ok).toBe(true);
+ first.pts[0]={x:90000,y:10000};
+ expect(shaper.legalise(0,from,to).pts[0]!.x).toBe(0);
+ journal.addTrack({net:1,sheet:0,pts:[{x:5000,y:9000},{x:5000,y:11000}],width:200,kind:1,hold:'free'});
+ expect(shaper.legalise(0,from,to).ok).toBe(false);
+ expect(shaper.legalise(0,from,to).ok).toBe(false);
+ journal.rewind(mark);shaper.clear();
+ expect(shaper.legalise(0,from,to).ok).toBe(true);
+});
