{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep|Bash|Edit|Write|MultiEdit|NotebookEdit|WebFetch|WebSearch|Agent",
        "hooks": [
          { "type": "command", "timeout": 15, "command": "bun run \"$CLAUDE_PROJECT_DIR/tools/wall/pretooluse.ts\"" }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "timeout": 15, "command": "bun run \"$CLAUDE_PROJECT_DIR/tools/wall/subagent-start.ts\"" }
        ]
      }
    ]
  }
}
